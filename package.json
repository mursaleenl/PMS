    "lucide-react": "^0.468.0",
    "next": "^16.4.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@eslint/eslintrc": "^0.1.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^4.0.0",
    "eslint-config-next": "^0.2.4",
    "supabase": "3.1.0",
    "typescript": "^5.7.2"
